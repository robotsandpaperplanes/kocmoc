BOT_TOKEN=1234567890:replace_me
DATABASE_PATH=./data/bot.sqlite3
# Telegram ID владельца или сотрудников через запятую.
# Узнать свой ID можно командой /myid после первого запуска.
ADMIN_TELEGRAM_IDS=
# Для production разместите обе папки на постоянном диске хостинга.
BACKUP_DIR=./data/backups
# 0 отключает автоматические резервные копии.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
NOTIFY_ADMINS_ON_ERROR=true
